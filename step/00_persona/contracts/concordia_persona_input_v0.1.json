{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona/concordia_persona_input_v0.1",
  "title": "Concordia Persona Input",
  "description": "A minimized, source-grounded Persona view for constructing an Agent. The Game Master remains authoritative for world permissions and consequences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "agent_id",
    "persona_reference",
    "prompt_profile",
    "memory_seeds",
    "capability_hints",
    "safety_boundary"
  ],
  "properties": {
    "contract_version": { "const": "concordia_persona_input_v0.1" },
    "agent_id": { "type": "string" },
    "persona_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "source_dataset", "projection_status"],
      "properties": {
        "persona_id": { "type": "string" },
        "source_dataset": { "type": "string" },
        "projection_status": { "enum": ["confirmed", "partial_confirmed", "draft_for_review"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prompt_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounded_attributes", "known_unknowns", "prohibited_content"],
      "properties": {
        "grounded_attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["persona_path", "value", "evidence_ids"],
            "properties": {
              "persona_path": { "type": "string" },
              "value": { "type": ["string", "number", "boolean", "object", "array", "null"] },
              "evidence_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "known_unknowns": { "type": "array", "items": { "type": "string" } },
        "prohibited_content": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "memory_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "evidence_ids", "visibility"],
        "properties": {
          "content": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "visibility": { "enum": ["private_to_agent", "public_in_world"] }
        }
      }
    },
    "capability_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "evidence_ids"],
        "properties": {
          "capability": { "type": "string" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_permissions_authoritative", "target_behavior_excluded", "cross_source_joined"],
      "properties": {
        "world_permissions_authoritative": { "const": true },
        "target_behavior_excluded": { "const": true },
        "cross_source_joined": { "const": false }
      }
    }
  }
}
